{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",         // ✅ modern, works best with Vite
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["react", "react-dom"],
    "baseUrl": ".",
    "resolveJsonModule": true              // ✅ useful if you ever import JSON
  },
  "include": ["src"]
}
